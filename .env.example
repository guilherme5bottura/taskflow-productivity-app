# 1. Configurações do Backend / Vercel Serverless
PORT=3001
NODE_ENV=production
JWT_SECRET=coloque_aqui_uma_chave_secreta_jwt_longa_e_segura

# Caminho customizado para o banco SQLite (opcional):
